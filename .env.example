# Supabase 项目配置（Project Settings -> API 中获取）
# 复制本文件为 .env 后填入真实值
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# 站点正式域名（用于 SEO / RSS / Sitemap / OG 链接）
VITE_SITE_URL=https://lpw94.github.io

# 放映厅「OuonnkiTV」标签的内嵌地址（可不填，页面上直接填会存到本机 localStorage）
# 填了之后页面就不给改地址，适合固定一处自建站点的情况
VITE_OUONNKI_URL=

# 悬浮音乐播放器的网易云歌单
# 歌单 ID 取分享链接里的那段数字：https://music.163.com/playlist?id=3778678
# 不填时默认用云音乐热歌榜（3778678）
VITE_NETEASE_PLAYLIST=
# Meting 转接接口（把歌单 ID 转成可播放直链），默认用 i-meto 的公开实例
VITE_METING_API=
