# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo
# tsc 误编译 vite.config.ts 产生的产物（不应入库）
vite.config.js
vite.config.d.ts

# 本地环境变量（含密钥，禁止提交）
.env
.env.local
.env.*.local

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.log
.playwright-cli/

# 发布用的临时文件（可能含 service_role key，禁止提交）
.workbuddy/tmp/
.publish-tmp/

# 发布工具（本地保留，不入库）
# 原因：extract-token.mjs 会从浏览器 leveldb 里抽取登录 JWT ——
# 这类工具不适合出现在公开仓库里。脚本本身不含密钥，但放进公开仓库
# 等于把「怎么从本机浏览器捞出登录态」写成教程。
scripts/publish/
